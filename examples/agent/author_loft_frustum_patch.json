{
  "intent": "Author a square frustum lofted from a 40 mm base to a 20 mm top 30 mm higher",
  "rationale": "Two fully constrained square sections on parallel workplanes skinned by a loft",
  "operations": [
    {
      "type": "add_parameter",
      "id": "param:base_size",
      "name": "base_size",
      "expr": "40 mm"
    },
    {
