      "name": "Base Square",
      "workplane": {
        "type": "global",
        "plane": "XY"
      }
    },
    {
      "type": "add_sketch_entity",
      "sketch_id": "sketch:base",
      "entity": {
        "type": "point",
        "id": "ent:base_c0",
        "x": -0.02,
        "y": -0.02
      }
    },
    {
      "type": "add_sketch_entity",
      "sketch_id": "sketch:base",
      "entity": {
        "type": "point",
        "id": "ent:base_c1",
