{
  "intent": "Create a rectangular plate with a parametric centerline rib",
  "operations": [
    {
      "type": "add_parameter",
      "id": "param:rib_thickness",
      "name": "rib_thickness",
      "expr": "4 mm"
    },
    {
      "type": "add_parameter",
      "id": "param:rib_height",
      "name": "rib_height",
      "expr": "12 mm"
    },
    {
      "type": "add_sketch",
      "id": "sketch:plate",
      "name": "Plate",
      "workplane": {
        "type": "global",
        "plane": "XY"
      }
    },
    {
      "type": "add_sketch_entity",
      "sketch_id": "sketch:plate",
      "entity": {
        "type": "rectangle",
        "id": "ent:plate",
        "construction": false,
        "origin": [
          0,
          0
        ],
        "size": [
          0.08,
          0.06
        ],
        "corner_ids": [
          "ent:plate_c0",
          "ent:plate_c1",
          "ent:plate_c2",
          "ent:plate_c3"
        ],
        "edge_ids": [
          "ent:plate_e0",
          "ent:plate_e1",
          "ent:plate_e2",
          "ent:plate_e3"
        ]
      }
    },
    {
      "type": "add_feature",
      "node": {
        "id": "feature:sketch_plate",
        "name": "Plate sketch",
        "definition": {
          "type": "sketch",
          "sketch_id": "sketch:plate"
        }
      },
      "position": {
        "at": "end"
      }
    },
    {
      "type": "add_feature",
      "node": {
        "id": "feature:plate",
        "name": "Plate",
        "definition": {
          "type": "extrude",
          "sketch_feature": "feature:sketch_plate",
          "profile_ref": "sketch:plate/profile:outer",
          "extent": {
            "type": "distance",
            "length": {
              "value_si": 0.004
            }
          },
          "operation": "new_body"
        }
      },
      "position": {
        "at": "end"
      }
    },
    {
      "type": "add_sketch",
      "id": "sketch:rib",
      "name": "Rib centerline",
      "workplane": {
        "type": "custom",
        "origin": [
          0,
          0,
          0.004
        ],
        "normal": [
          0,
          0,
          1
        ],
        "x_axis": [
          1,
          0,
          0
        ]
      }
    },
    {
      "type": "add_sketch_entity",
      "sketch_id": "sketch:rib",
      "entity": {
        "type": "point",
        "id": "ent:rib_start",
        "construction": false,
        "x": 0.02,
        "y": 0.03
      }
    },
    {
      "type": "add_sketch_entity",
      "sketch_id": "sketch:rib",
      "entity": {
        "type": "point",
        "id": "ent:rib_end",
        "construction": false,
        "x": 0.06,
        "y": 0.03
      }
    },
    {
      "type": "add_sketch_entity",
      "sketch_id": "sketch:rib",
      "entity": {
        "type": "line",
        "id": "ent:rib_line",
        "construction": false,
        "start": "ent:rib_start",
        "end": "ent:rib_end"
      }
    },
    {
      "type": "add_sketch_entity",
      "sketch_id": "sketch:rib",
      "entity": {
        "type": "rectangle",
        "id": "ent:rib_validator_profile",
        "construction": false,
        "origin": [
          -0.001,
          -0.001
        ],
        "size": [
          0.001,
          0.001
        ],
        "corner_ids": [
          "ent:rib_v0",
          "ent:rib_v1",
          "ent:rib_v2",
          "ent:rib_v3"
        ],
        "edge_ids": [
          "ent:rib_ve0",
          "ent:rib_ve1",
          "ent:rib_ve2",
          "ent:rib_ve3"
        ]
      }
    },
    {
      "type": "add_feature",
      "node": {
        "id": "feature:sketch_rib",
        "name": "Rib sketch",
        "definition": {
          "type": "sketch",
          "sketch_id": "sketch:rib"
        }
      },
      "position": {
        "at": "end"
      }
    },
    {
      "type": "add_feature",
      "node": {
        "id": "feature:rib",
        "name": "Centerline rib",
        "definition": {
          "type": "rib",
          "sketch_feature": "feature:sketch_rib",
          "centerline_ref": "ent:rib_line",
          "target_feature": "feature:plate",
          "thickness": {
            "value_si": 0.004
          },
          "thickness_expr": "rib_thickness",
          "extent": {
            "type": "distance",
            "length": {
              "value_si": 0.012
            }
          },
          "length_expr": "rib_height"
        }
      },
      "position": {
        "at": "end"
      }
    }
  ]
}
