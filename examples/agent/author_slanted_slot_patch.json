{
  "operations": [
    {
      "type": "add_parameter",
      "id": "param:slot_length",
      "name": "slot_length",
      "expr": "30 mm"
    },
    {
      "type": "add_parameter",
      "id": "param:slot_width",
      "name": "slot_width",
      "expr": "8 mm"
    },
    {
      "type": "add_parameter",
      "id": "param:slot_angle",
      "name": "slot_angle",
      "expr": "30 deg"
    },
    {
      "type": "add_parameter",
      "id": "param:thickness",
      "name": "thickness",
      "expr": "5 mm"
    },
    {
      "type": "add_sketch",
      "id": "sketch:slot",
      "name": "Slanted Slot",
      "workplane": {
        "type": "global",
        "plane": "XY"
      }
    },
    {
      "type": "add_sketch_entity",
      "sketch_id": "sketch:slot",
      "entity": {
        "type": "point",
        "id": "ent:c_left",
        "x": 0.0,
        "y": 0.0
      }
    },
    {
      "type": "add_sketch_entity",
      "sketch_id": "sketch:slot",
      "entity": {
        "type": "point",
        "id": "ent:c_right",
        "x": 0.025981,
        "y": 0.015
      }
    },
    {
      "type": "add_sketch_entity",
      "sketch_id": "sketch:slot",
      "entity": {
        "type": "point",
        "id": "ent:ref_end",
        "x": 0.02,
        "y": 0.0
      }
    },
    {
      "type": "add_sketch_entity",
      "sketch_id": "sketch:slot",
      "entity": {
        "type": "point",
        "id": "ent:s0",
        "x": 0.002,
        "y": -0.003464
      }
    },
    {
      "type": "add_sketch_entity",
      "sketch_id": "sketch:slot",
      "entity": {
        "type": "point",
        "id": "ent:s1",
        "x": 0.027981,
        "y": 0.011536
      }
    },
    {
      "type": "add_sketch_entity",
      "sketch_id": "sketch:slot",
      "entity": {
        "type": "point",
        "id": "ent:s2",
        "x": 0.023981,
        "y": 0.018464
      }
    },
    {
      "type": "add_sketch_entity",
      "sketch_id": "sketch:slot",
      "entity": {
        "type": "point",
        "id": "ent:s3",
        "x": -0.002,
        "y": 0.003464
      }
    },
    {
      "type": "add_sketch_entity",
      "sketch_id": "sketch:slot",
      "entity": {
        "type": "line",
        "id": "ent:axis",
        "start": "ent:c_left",
        "end": "ent:ref_end",
        "construction": true
      }
    },
    {
      "type": "add_sketch_entity",
      "sketch_id": "sketch:slot",
      "entity": {
        "type": "line",
        "id": "ent:centerline",
        "start": "ent:c_left",
        "end": "ent:c_right",
        "construction": true
      }
    },
    {
      "type": "add_sketch_entity",
      "sketch_id": "sketch:slot",
      "entity": {
        "type": "line",
        "id": "ent:bottom",
        "start": "ent:s0",
        "end": "ent:s1"
      }
    },
    {
      "type": "add_sketch_entity",
      "sketch_id": "sketch:slot",
      "entity": {
        "type": "arc",
        "id": "ent:right",
        "center": "ent:c_right",
        "radius": 0.004,
        "start_angle": "slot_angle - 90 deg",
        "end_angle": "slot_angle + 90 deg",
        "start_point": "ent:s1",
        "end_point": "ent:s2"
      }
    },
    {
      "type": "add_sketch_entity",
      "sketch_id": "sketch:slot",
      "entity": {
        "type": "line",
        "id": "ent:top",
        "start": "ent:s2",
        "end": "ent:s3"
      }
    },
    {
      "type": "add_sketch_entity",
      "sketch_id": "sketch:slot",
      "entity": {
        "type": "arc",
        "id": "ent:left",
        "center": "ent:c_left",
        "radius": 0.004,
        "start_angle": "slot_angle + 90 deg",
        "end_angle": "slot_angle + 270 deg",
        "start_point": "ent:s3",
        "end_point": "ent:s0"
      }
    },
    {
      "type": "add_sketch_constraint",
      "sketch_id": "sketch:slot",
      "constraint": {
        "type": "horizontal",
        "id": "con:axis_horizontal",
        "line": "ent:axis"
      }
    },
    {
      "type": "add_sketch_constraint",
      "sketch_id": "sketch:slot",
      "constraint": {
        "type": "distance",
        "id": "con:axis_length",
        "target": {
          "line": "ent:axis"
        },
        "expr": "20 mm"
      }
    },
    {
      "type": "add_sketch_constraint",
      "sketch_id": "sketch:slot",
      "constraint": {
        "type": "angle",
        "id": "con:slot_angle",
        "line_a": "ent:axis",
        "line_b": "ent:centerline",
        "expr": "slot_angle"
      }
    },
    {
      "type": "add_sketch_constraint",
      "sketch_id": "sketch:slot",
      "constraint": {
        "type": "distance",
        "id": "con:slot_length",
        "target": {
          "line": "ent:centerline"
        },
        "expr": "slot_length"
      }
    },
    {
      "type": "add_sketch_constraint",
      "sketch_id": "sketch:slot",
      "constraint": {
        "type": "radius",
        "id": "con:right_radius",
        "target": "ent:right",
        "expr": "slot_width / 2"
      }
    },
    {
      "type": "add_sketch_constraint",
      "sketch_id": "sketch:slot",
      "constraint": {
        "type": "radius",
        "id": "con:left_radius",
        "target": "ent:left",
        "expr": "slot_width / 2"
      }
    },
    {
      "type": "add_sketch_constraint",
      "sketch_id": "sketch:slot",
      "constraint": {
        "type": "tangent",
        "id": "con:bottom_tangent",
        "line": "ent:bottom",
        "curve": "ent:right"
      }
    },
    {
      "type": "add_sketch_constraint",
      "sketch_id": "sketch:slot",
      "constraint": {
        "type": "tangent",
        "id": "con:top_tangent",
        "line": "ent:top",
        "curve": "ent:left"
      }
    },
    {
      "type": "add_feature",
      "position": {
        "at": "end"
      },
      "node": {
        "id": "feature:sketch_slot",
        "name": "Slot Sketch",
        "definition": {
          "type": "sketch",
          "sketch_id": "sketch:slot"
        }
      }
    },
    {
      "type": "add_feature",
      "position": {
        "at": "end"
      },
      "node": {
        "id": "feature:slot",
        "name": "Slot",
        "definition": {
          "type": "extrude",
          "sketch_feature": "feature:sketch_slot",
          "profile_ref": "sketch:slot/profile:outer",
          "extent": {
            "type": "distance",
            "length": {
              "value_si": 0.005
            }
          },
          "operation": "new_body",
          "length_expr": "thickness"
        }
      }
    }
  ]
}
