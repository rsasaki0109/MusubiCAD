{
  "intent": "Author a 60 x 40 x 5 mm plate with a 30 mm long, 8 mm wide through slot",
  "rationale": "The slot outline joins two lines and two arcs through shared endpoint points",
  "operations": [
    { "type": "add_parameter", "id": "param:width", "name": "width", "expr": "60 mm" },
    { "type": "add_parameter", "id": "param:depth", "name": "depth", "expr": "40 mm" },
    { "type": "add_parameter", "id": "param:thickness", "name": "thickness", "expr": "5 mm" },
    { "type": "add_parameter", "id": "param:slot_length", "name": "slot_length", "expr": "30 mm" },
    { "type": "add_parameter", "id": "param:slot_width", "name": "slot_width", "expr": "8 mm" },

    { "type": "add_sketch", "id": "sketch:base", "name": "Base Sketch",
      "workplane": { "type": "global", "plane": "XY" } },
    { "type": "add_sketch_entity", "sketch_id": "sketch:base",
      "entity": { "type": "point", "id": "ent:c0", "x": 0.0, "y": 0.0 } },
    { "type": "add_sketch_entity", "sketch_id": "sketch:base",
      "entity": { "type": "point", "id": "ent:c1", "x": 0.06, "y": 0.0 } },
    { "type": "add_sketch_entity", "sketch_id": "sketch:base",
      "entity": { "type": "point", "id": "ent:c2", "x": 0.06, "y": 0.04 } },
    { "type": "add_sketch_entity", "sketch_id": "sketch:base",
      "entity": { "type": "point", "id": "ent:c3", "x": 0.0, "y": 0.04 } },
    { "type": "add_sketch_entity", "sketch_id": "sketch:base",
      "entity": { "type": "line", "id": "ent:e0", "start": "ent:c0", "end": "ent:c1" } },
    { "type": "add_sketch_entity", "sketch_id": "sketch:base",
      "entity": { "type": "line", "id": "ent:e1", "start": "ent:c1", "end": "ent:c2" } },
    { "type": "add_sketch_entity", "sketch_id": "sketch:base",
      "entity": { "type": "line", "id": "ent:e2", "start": "ent:c2", "end": "ent:c3" } },
    { "type": "add_sketch_entity", "sketch_id": "sketch:base",
      "entity": { "type": "line", "id": "ent:e3", "start": "ent:c3", "end": "ent:c0" } },
    { "type": "add_sketch_constraint", "sketch_id": "sketch:base",
      "constraint": { "type": "distance", "id": "con:width", "target": { "line": "ent:e0" }, "expr": "width" } },
    { "type": "add_sketch_constraint", "sketch_id": "sketch:base",
      "constraint": { "type": "distance", "id": "con:depth", "target": { "line": "ent:e1" }, "expr": "depth" } },
    { "type": "add_sketch_constraint", "sketch_id": "sketch:base",
      "constraint": { "type": "horizontal", "id": "con:e0_horizontal", "line": "ent:e0" } },
    { "type": "add_sketch_constraint", "sketch_id": "sketch:base",
      "constraint": { "type": "horizontal", "id": "con:e2_horizontal", "line": "ent:e2" } },
    { "type": "add_sketch_constraint", "sketch_id": "sketch:base",
      "constraint": { "type": "vertical", "id": "con:e1_vertical", "line": "ent:e1" } },
    { "type": "add_sketch_constraint", "sketch_id": "sketch:base",
      "constraint": { "type": "vertical", "id": "con:e3_vertical", "line": "ent:e3" } },

    { "type": "add_sketch", "id": "sketch:slot", "name": "Slot Sketch",
      "workplane": { "type": "global", "plane": "XY" } },
    { "type": "add_sketch_entity", "sketch_id": "sketch:slot",
      "entity": { "type": "point", "id": "ent:s0", "x": 0.015, "y": 0.016 } },
    { "type": "add_sketch_entity", "sketch_id": "sketch:slot",
      "entity": { "type": "point", "id": "ent:s1", "x": 0.045, "y": 0.016 } },
    { "type": "add_sketch_entity", "sketch_id": "sketch:slot",
      "entity": { "type": "point", "id": "ent:s2", "x": 0.045, "y": 0.024 } },
    { "type": "add_sketch_entity", "sketch_id": "sketch:slot",
      "entity": { "type": "point", "id": "ent:s3", "x": 0.015, "y": 0.024 } },
    { "type": "add_sketch_entity", "sketch_id": "sketch:slot",
      "entity": { "type": "point", "id": "ent:c_left", "x": 0.015, "y": 0.02 } },
    { "type": "add_sketch_entity", "sketch_id": "sketch:slot",
      "entity": { "type": "point", "id": "ent:c_right", "x": 0.045, "y": 0.02 } },
    { "type": "add_sketch_entity", "sketch_id": "sketch:slot",
      "entity": { "type": "line", "id": "ent:bottom", "start": "ent:s0", "end": "ent:s1" } },
    { "type": "add_sketch_entity", "sketch_id": "sketch:slot",
      "entity": { "type": "arc", "id": "ent:right", "center": "ent:c_right", "radius": 0.004,
                  "start_angle": "-90 deg", "end_angle": "90 deg",
                  "start_point": "ent:s1", "end_point": "ent:s2" } },
    { "type": "add_sketch_entity", "sketch_id": "sketch:slot",
      "entity": { "type": "line", "id": "ent:top", "start": "ent:s2", "end": "ent:s3" } },
    { "type": "add_sketch_entity", "sketch_id": "sketch:slot",
      "entity": { "type": "arc", "id": "ent:left", "center": "ent:c_left", "radius": 0.004,
                  "start_angle": "90 deg", "end_angle": "270 deg",
                  "start_point": "ent:s3", "end_point": "ent:s0" } },
    { "type": "add_sketch_constraint", "sketch_id": "sketch:slot",
      "constraint": { "type": "radius", "id": "con:right_radius", "target": "ent:right", "expr": "slot_width / 2" } },
    { "type": "add_sketch_constraint", "sketch_id": "sketch:slot",
      "constraint": { "type": "radius", "id": "con:left_radius", "target": "ent:left", "expr": "slot_width / 2" } },
    { "type": "add_sketch_constraint", "sketch_id": "sketch:slot",
      "constraint": { "type": "horizontal", "id": "con:bottom_horizontal", "line": "ent:bottom" } },
    { "type": "add_sketch_constraint", "sketch_id": "sketch:slot",
      "constraint": { "type": "distance", "id": "con:slot_length", "target": { "line": "ent:bottom" }, "expr": "slot_length" } },

    { "type": "add_feature", "position": { "at": "end" },
      "node": { "id": "feature:sketch_base", "name": "Base Sketch",
                "definition": { "type": "sketch", "sketch_id": "sketch:base" } } },
    { "type": "add_feature", "position": { "at": "end" },
      "node": { "id": "feature:plate", "name": "Plate",
                "definition": { "type": "extrude", "sketch_feature": "feature:sketch_base",
                                "profile_ref": "sketch:base/profile:outer",
                                "extent": { "type": "distance", "length": { "value_si": 0.005 } },
                                "operation": "new_body", "length_expr": "thickness" } } },
    { "type": "add_feature", "position": { "at": "end" },
      "node": { "id": "feature:sketch_slot", "name": "Slot Sketch",
                "definition": { "type": "sketch", "sketch_id": "sketch:slot" } } },
    { "type": "add_feature", "position": { "at": "end" },
      "node": { "id": "feature:slot", "name": "Through Slot",
                "definition": { "type": "hole", "sketch_feature": "feature:sketch_slot",
                                "profile_ref": "sketch:slot/profile:outer",
                                "depth": { "type": "distance", "length": { "value_si": 0.005 } },
                                "target_feature": "feature:plate", "depth_expr": "thickness" } } }
  ]
}
