        "name": "Plate",
        "definition": {
          "type": "extrude",
          "sketch_feature": "feature:sketch_plate",
          "profile_ref": "sketch:plate/profile:outer",
          "extent": {
            "type": "distance",
            "length": {
              "value_si": 0.006
            }
          },
          "operation": "new_body"
        }
      },
      "position": {
        "at": "end"
      }
    },
    {
      "type": "add_semantic_ref",
      "topo_ref": {
        "ref_id": "ref:edge:circle",
        "kind": "edge",
        "semantic": {
          "created_by": "feature:plate",
          "role": "top@-y"
        }
      }
    }
  ]
