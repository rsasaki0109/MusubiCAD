{
  "intent": "Create a radius 10 mm, height 6 mm cylinder with a semantic top circle",
  "operations": [
    {
      "type": "add_sketch",
      "id": "sketch:plate",
      "name": "Plate",
      "workplane": {
        "type": "global",
        "plane": "XY"
      }
    },
    {
      "type": "add_sketch_entity",
      "sketch_id": "sketch:plate",
      "entity": {
        "type": "point",
        "id": "ent:center",
        "x": 0.0,
        "y": 0.0
      }
    },
    {
      "type": "add_sketch_entity",
      "sketch_id": "sketch:plate",
      "entity": {
        "type": "circle",
        "id": "ent:circle",
        "center": "ent:center",
        "radius": 0.01
      }
    },
    {
      "type": "add_feature",
      "node": {
        "id": "feature:sketch_plate",
