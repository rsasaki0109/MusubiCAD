{
  "intent": "Build a plate on a parametric datum plane and add a parametric construction axis",
  "operations": [
    {
      "type": "add_parameter",
      "id": "param:offset",
      "name": "offset",
      "expr": "5 mm"
    },
    {
      "type": "add_parameter",
      "id": "param:axis_x",
      "name": "axis_x",
      "expr": "5 mm"
    },
    {
      "type": "add_feature",
      "node": {
        "id": "feature:datum",
        "name": "datum",
        "definition": {
          "type": "datum_plane",
          "base": {
            "type": "global",
            "plane": "XY"
          },
          "offset": {
            "value_si": 0.005
          },
          "offset_expr": "offset"
        }
      },
      "position": {
        "at": "end"
      }
    },
    {
      "type": "add_feature",
      "node": {
        "id": "feature:axis",
        "name": "axis",
        "definition": {
          "type": "datum_axis",
          "origin_m": [
            0,
            0,
            0
          ],
          "direction": [
            0,
            1,
            0
          ],
          "origin_expr": [
            "axis_x",
            null,
            null
          ]
        }
      },
      "position": {
        "at": "end"
      }
    },
    {
      "type": "add_sketch",
      "id": "sketch:plate",
      "name": "Plate",
      "workplane": {
        "type": "datum_plane",
        "feature_id": "feature:datum"
      }
    },
    {
      "type": "add_sketch_entity",
      "sketch_id": "sketch:plate",
      "entity": {
        "type": "rectangle",
        "id": "ent:plate",
        "construction": false,
        "origin": [
          0,
          0
        ],
        "size": [
          0.02,
          0.01
        ],
        "corner_ids": [
          "ent:c0",
          "ent:c1",
          "ent:c2",
          "ent:c3"
        ],
        "edge_ids": [
          "ent:e0",
          "ent:e1",
          "ent:e2",
          "ent:e3"
        ]
      }
    },
    {
      "type": "add_feature",
      "node": {
        "id": "feature:sketch",
        "name": "sketch",
        "definition": {
          "type": "sketch",
          "sketch_id": "sketch:plate"
        }
      },
      "position": {
        "at": "end"
      }
    },
    {
      "type": "add_feature",
      "node": {
        "id": "feature:extrude",
        "name": "extrude",
        "definition": {
          "type": "extrude",
          "sketch_feature": "feature:sketch",
          "profile_ref": "sketch:plate/profile:outer",
          "extent": {
            "type": "distance",
            "length": {
              "value_si": 0.004
            }
          },
          "operation": "new_body"
        }
      },
      "position": {
        "at": "end"
      }
    }
  ]
}
