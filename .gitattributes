# README review reports are generated byte-for-byte on every supported platform.
docs/assets/generate-review-demo.sh text eol=lf
docs/assets/generate-review-demo.ps1 text eol=lf
docs/assets/verify-review-demo.sh text eol=lf
docs/assets/review-demo/*.json text eol=lf
docs/assets/review-demo/*.html text eol=lf
docs/assets/review-demo/*.md text eol=lf
docs/assets/review-demo/*.png binary
docs/assets/review-demo/*.gif binary
quickstart.sh text eol=lf
quickstart.ps1 text eol=lf
tools/package-cli-release.ps1 text eol=lf

# Imported and exported STL bytes are immutable, checksum-bound CAD assets.
# ASCII STL must not be rewritten by Windows core.autocrlf checkout either.
*.stl binary
