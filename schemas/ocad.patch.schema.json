{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forgecad.dev/schemas/ocad.patch.v0.1.json",
  "title": "MusubiCAD DesignPatch",
  "type": "object",
  "required": ["operations"],
  "properties": {
    "intent": { "type": "string", "minLength": 1 },
    "rationale": { "type": "string", "minLength": 1 },
    "preconditions": {
      "type": "array",
      "items": { "$ref": "#/$defs/precondition" }
    },
    "expected_effects": {
      "type": "array",
      "items": { "$ref": "#/$defs/expected_effect" }
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": { "$ref": "#/$defs/operation" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "operation": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {
          "enum": [
            "set_parameter",
            "set_feature_expr",
            "set_feature_ref",
            "assign_face_ref",
            "set_instance_placement",
            "set_mate_distance",
            "add_connector",
            "set_drawing_view_scale",
            "set_drawing_view_origin",
            "add_parameter",
            "remove_parameter",
            "add_assertion",
            "remove_assertion"
          ]
        }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "add_parameter" } } },
          "then": {
            "required": ["type", "id", "name", "expr"],
            "properties": {
              "id": { "$ref": "#/$defs/stable_id_param" },
              "name": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
              "expr": { "type": "string", "minLength": 1 }
            }
          }
        },
        {
          "if": { "properties": { "type": { "const": "remove_parameter" } } },
          "then": {
            "required": ["type", "id"],
            "properties": { "id": { "type": "string", "pattern": "^param:" } }
          }
        },
        {
          "if": { "properties": { "type": { "const": "add_assertion" } } },
          "then": {
            "required": ["type", "assertion"],
            "properties": {
              "assertion": {
                "type": "object",
                "required": ["id", "name", "severity", "type"],
                "properties": {
                  "id": { "$ref": "#/$defs/stable_id_assertion" },
                  "name": { "type": "string", "minLength": 1 },
                  "severity": { "enum": ["required", "advisory"] }
                }
              }
            }
          }
        },
        {
          "if": { "properties": { "type": { "const": "remove_assertion" } } },
          "then": {
            "required": ["type", "id"],
            "properties": { "id": { "type": "string", "pattern": "^assertion:" } }
          }
        }
      ]
    },
    "stable_id_param": {
      "type": "string",
      "maxLength": 128,
      "pattern": "^param:[a-z0-9_]+([.][a-z0-9_]+)*$"
    },
    "stable_id_assertion": {
      "type": "string",
      "maxLength": 128,
      "pattern": "^assertion:[a-z0-9_]+([.][a-z0-9_]+)*$"
    },
    "precondition": {
      "oneOf": [
        {
          "type": "object",
          "required": ["type", "algorithm", "version", "digest"],
          "properties": {
            "type": { "const": "revision_equals" },
            "algorithm": { "const": "sha256" },
            "version": {
              "enum": ["musubicad.design-state.v1", "musubicad.design-state.v2"]
            },
            "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["type", "id", "expr"],
          "properties": {
            "type": { "const": "parameter_expr_equals" },
            "id": { "type": "string", "pattern": "^param:" },
            "expr": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["type", "id"],
          "properties": {
            "type": { "const": "feature_exists" },
            "id": { "type": "string", "pattern": "^feature:" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["type", "ref_id"],
          "properties": {
            "type": { "const": "topo_ref_exists" },
            "ref_id": { "type": "string", "pattern": "^ref:" }
          },
          "additionalProperties": false
        }
      ]
    },
    "expected_effect": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {
          "enum": [
            "parameter_expr_equals",
            "mass_delta_kg",
            "drawing_changed",
            "no_assembly_interference"
          ]
        },
        "id": { "type": "string" },
        "expr": { "type": "string" },
        "min": { "type": "number" },
        "max": { "type": "number" },
        "expected": { "type": "boolean" }
      }
    }
  }
}
