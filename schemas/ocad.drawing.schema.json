{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opencad.dev/schemas/ocad.drawing.v0.1.json",
  "title": "MusubiCAD Drawing Model",
  "type": "object",
  "properties": {
    "sheets": {
      "type": "array",
      "items": { "$ref": "#/$defs/sheet" }
    }
  },
  "$defs": {
    "sheet": {
      "type": "object",
      "required": ["id", "name", "width_m", "height_m", "views"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^sheet:[a-zA-Z0-9_:/-]+$"
        },
        "name": { "type": "string", "minLength": 1 },
        "width_m": { "type": "number", "exclusiveMinimum": 0 },
        "height_m": { "type": "number", "exclusiveMinimum": 0 },
        "views": {
          "type": "array",
          "items": { "$ref": "#/$defs/view" }
        },
        "dimensions": {
          "type": "array",
          "items": { "$ref": "#/$defs/linear_dimension" }
        },
        "radial_dimensions": {"type":"array","items":{"$ref":"#/$defs/radial_dimension"}},
        "angular_dimensions": { "type": "array", "items": { "$ref": "#/$defs/angular_dimension" } }
      },
      "additionalProperties": false
    },
    "radial_dimension": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "view_id",
        "edge_ref",
        "kind",
        "leader_direction",
        "leader_extension_m"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^dim:[a-zA-Z0-9_:/-]+$"
        },
        "view_id": {
          "type": "string",
          "pattern": "^view:[a-zA-Z0-9_:/-]+$"
        },
        "edge_ref": {
          "type": "string",
          "pattern": "^ref:edge:[a-zA-Z0-9_:/-]+$"
        },
        "kind": {
          "enum": [
            "radius",
            "diameter"
          ]
        },
        "leader_direction": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "number"
          }
        },
        "leader_extension_m": {
          "type": "number",
          "exclusiveMinimum": 1e-09
        }
      }
    },
    "angular_dimension": {
      "type": "object",
      "required": [
        "id",
        "view_id",
        "arc_radius_m"
      ],
      "oneOf": [
        {
          "required": [
            "edge_refs"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "vertex_model_m"
                ]
              },
              {
                "required": [
                  "first_model_m"
                ]
              },
              {
                "required": [
                  "second_model_m"
                ]
              }
            ]
          }
        },
        {
          "required": [
            "vertex_model_m",
            "first_model_m",
            "second_model_m"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "edge_refs"
                ]
              },
              {
                "required": [
                  "ray_ends"
                ]
              }
            ]
          }
        }
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^dim:[a-zA-Z0-9_:/-]+$"
        },
        "view_id": {
          "type": "string",
          "pattern": "^view:[a-zA-Z0-9_:/-]+$"
        },
        "arc_radius_m": {
          "type": "number",
          "exclusiveMinimum": 1e-09
        },
        "edge_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^ref:edge:[a-zA-Z0-9_:/-]+$"
          },
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true
        },
        "ray_ends": {
          "type": "array",
          "items": {
            "enum": [
              "start",
              "end"
            ]
          },
          "minItems": 2,
          "maxItems": 2
        },
        "vertex_model_m": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 3,
          "maxItems": 3
        },
        "first_model_m": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 3,
          "maxItems": 3
        },
        "second_model_m": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 3,
          "maxItems": 3
        }
      },
      "additionalProperties": false
    },
    "linear_dimension": {
      "type": "object",
      "required": ["id", "view_id", "offset_m"],
      "oneOf": [
        { "required": ["edge_ref"], "not": { "anyOf": [{ "required": ["start_model_m"] }, { "required": ["end_model_m"] }] } },
        { "required": ["start_model_m", "end_model_m"], "not": { "required": ["edge_ref"] } }
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^dim:[a-zA-Z0-9_:/-]+$" },
        "view_id": { "type": "string", "pattern": "^view:[a-zA-Z0-9_:/-]+$" },
        "edge_ref": { "type": "string", "pattern": "^ref:edge:[a-zA-Z0-9_:/-]+$" },
        "start_model_m": {
          "type": "array",
          "items": { "type": "number" },
          "minItems": 3,
          "maxItems": 3
        },
        "end_model_m": {
          "type": "array",
          "items": { "type": "number" },
          "minItems": 3,
          "maxItems": 3
        },
        "offset_m": { "type": "number" }
      },
      "additionalProperties": false
    },
    "section_view": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "plane",
        "hatch_spacing_m"
      ],
      "properties": {
        "plane": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "origin_m",
            "normal"
          ],
          "properties": {
            "origin_m": {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "items": {
                "type": "number"
              }
            },
            "normal": {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "items": {
                "type": "number"
              }
            }
          }
        },
        "hatch_spacing_m": {
          "type": "number",
          "exclusiveMinimum": 1e-06
        }
      }
    },
    "view": {
      "type": "object",
      "required": [
        "id",
        "name",
        "model",
        "projection",
        "scale",
        "origin_on_sheet_m"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^view:[a-zA-Z0-9_:/-]+$"
        },
        "name": { "type": "string", "minLength": 1 },
        "model": { "$ref": "#/$defs/model_reference" },
        "section": {"anyOf":[{"$ref":"#/$defs/section_view"},{"type":"null"}]},
        "projection": {
          "type": "string",
          "enum": ["front", "top", "right", "isometric"]
        },
        "scale": { "type": "number", "exclusiveMinimum": 0 },
        "origin_on_sheet_m": {
          "type": "array",
          "items": { "type": "number" },
          "minItems": 2,
          "maxItems": 2
        }
      },
      "additionalProperties": false
    },
    "model_reference": {
      "type": "object",
      "required": ["source_path", "source_doc"],
      "properties": {
        "source_path": { "type": "string", "minLength": 1 },
        "source_doc": {
          "type": "string",
          "pattern": "^doc:[a-zA-Z0-9_-]+$"
        }
      },
      "additionalProperties": false
    }
  }
}
