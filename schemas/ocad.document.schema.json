{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opencad.dev/schemas/ocad.document.v0.1.json",
  "title": "MusubiCAD Document",
  "type": "object",
  "required": ["schema", "document"],
  "properties": {
    "schema": {
      "type": "string",
      "const": "opencad.document.v0.1"
    },
    "document": {
      "type": "object",
      "required": ["id", "name", "units"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^doc:[a-zA-Z0-9_-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "units": {
          "type": "string",
          "enum": ["m", "mm", "cm", "in"]
        },
        "kind": {
          "type": "string",
          "enum": ["part", "assembly", "drawing"],
          "default": "part"
        },
        "created_with": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "parameters": {
      "type": "array",
      "items": { "$ref": "#/$defs/parameter" }
    },
    "sketches": {
      "type": "array",
      "items": { "$ref": "#/$defs/sketch" }
    },
    "features": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "definition": {
            "type": "object",
            "allOf": [
              { "if": { "properties": { "type": { "const": "draft" } }, "required": ["type"] }, "then": { "$ref": "#/$defs/draft" } },
              { "if": { "properties": { "type": { "const": "rib" } }, "required": ["type"] }, "then": { "$ref": "#/$defs/rib" } },
              { "if": { "properties": { "type": { "const": "datum_plane" } }, "required": ["type"] }, "then": { "$ref": "#/$defs/datum_plane" } },
              { "if": { "properties": { "type": { "const": "datum_axis" } }, "required": ["type"] }, "then": { "$ref": "#/$defs/datum_axis" } }
            ]
          }
        }
      }
    },
    "materials": {
      "type": "array",
      "items": { "type": "object" }
    },
    "ai": {
      "type": "object",
      "properties": {
        "intent_summary": { "type": "string" },
        "editable_parameters": {
          "type": "array",
          "items": { "type": "string" }
        },
        "semantic_tags": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    }
  },
  "$defs": {
    "draft": {
      "type": "object",
      "required": [
        "type",
        "target_feature",
        "angle",
        "neutral_plane",
        "face_refs"
      ],
      "properties": {
        "type": {
          "const": "draft"
        },
        "target_feature": {
          "type": "string",
          "pattern": "^feature:"
        },
        "angle": {
          "type": "object",
          "required": [
            "value_si"
          ],
          "properties": {
            "value_si": {
              "type": "number",
              "minimum": -0.7853981633974483,
              "maximum": 0.7853981633974483
            }
          },
          "additionalProperties": false
        },
        "angle_expr": {
          "type": [
            "string",
            "null"
          ]
        },
        "neutral_plane": {
          "oneOf": [
            {
              "type": "object",
              "required": [
                "type",
                "plane"
              ],
              "properties": {
                "type": {
                  "const": "global"
                },
                "plane": {
                  "enum": [
                    "XY",
                    "XZ",
                    "YZ"
                  ]
                }
              },
              "additionalProperties": false
            },
            {
              "type": "object",
              "required": [
                "type",
                "feature_id"
              ],
              "properties": {
                "type": {
                  "const": "datum_plane"
                },
                "feature_id": {
                  "type": "string",
                  "pattern": "^feature:"
                }
              },
              "additionalProperties": false
            },
            {
              "type": "object",
              "required": [
                "type",
                "face_ref"
              ],
              "properties": {
                "type": {
                  "const": "face_ref"
                },
                "face_ref": {
                  "type": "string",
                  "pattern": "^ref:face:"
                }
              },
              "additionalProperties": false
            },
            {
              "type": "object",
              "required": [
                "type",
                "origin",
                "normal",
                "x_axis"
              ],
              "properties": {
                "type": {
                  "const": "custom"
                },
                "origin": {
                  "type": "array",
                  "minItems": 3,
                  "maxItems": 3,
                  "items": {
                    "type": "number"
                  }
                },
                "normal": {
                  "type": "array",
                  "minItems": 3,
                  "maxItems": 3,
                  "items": {
                    "type": "number"
                  }
                },
                "x_axis": {
                  "type": "array",
                  "minItems": 3,
                  "maxItems": 3,
                  "items": {
                    "type": "number"
                  }
                }
              },
              "additionalProperties": false
            }
          ]
        },
        "face_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^ref:face:"
          }
        }
      },
      "additionalProperties": false
    },
    "rib": {
      "type": "object",
      "required": [
        "type",
        "sketch_feature",
        "centerline_ref",
        "target_feature",
        "thickness",
        "extent"
      ],
      "properties": {
        "type": { "const": "rib" },
        "sketch_feature": { "type": "string", "pattern": "^feature:" },
        "centerline_ref": { "type": "string", "pattern": "^ent:" },
        "target_feature": { "type": "string", "pattern": "^feature:" },
        "thickness": {
          "type": "object",
          "required": ["value_si"],
          "properties": {
            "value_si": { "type": "number", "exclusiveMinimum": 0 }
          },
          "additionalProperties": false
        },
        "thickness_expr": { "type": ["string", "null"] },
        "extent": {
          "type": "object",
          "required": ["type", "length"],
          "properties": {
            "type": { "const": "distance" },
            "length": {
              "type": "object",
              "required": ["value_si"],
              "properties": {
                "value_si": { "type": "number", "exclusiveMinimum": 0 }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "length_expr": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
      "datum_workplane": {
        "type": "object",
        "required": [
          "type",
          "feature_id"
        ],
        "properties": {
          "type": {
            "const": "datum_plane"
          },
          "feature_id": {
            "type": "string",
            "pattern": "^feature:"
          }
        },
        "additionalProperties": false
      },
      "datum_plane": {
        "type": "object",
        "required": [
          "type",
          "base",
          "offset"
        ],
        "properties": {
          "type": {
            "const": "datum_plane"
          },
          "base": {
            "type": "object"
          },
          "offset": {
            "type": "object",
            "required": [
              "value_si"
            ],
            "properties": {
              "value_si": {
                "type": "number"
              }
            }
          },
          "offset_expr": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": false
      },
      "datum_axis": {
        "type": "object",
        "required": [
          "type",
          "origin_m",
          "direction"
        ],
        "properties": {
          "type": {
            "const": "datum_axis"
          },
          "origin_m": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": {
              "type": "number"
            }
          },
          "direction": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": {
              "type": "number"
            }
          },
          "origin_expr": {
            "type": [
              "array",
              "null"
            ],
            "minItems": 3,
            "maxItems": 3,
            "items": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "additionalProperties": false
      },
    "sketch": {
      "type": "object",
      "properties": {
        "workplane": {
          "type": "object",
          "allOf": [{ "if": { "properties": { "type": { "const": "datum_plane" } }, "required": ["type"] }, "then": { "$ref": "#/$defs/datum_workplane" } }]
        },
        "constraints": {
          "type": "array",
          "items": { "$ref": "#/$defs/sketch_constraint" }
        }
      }
    },
    "sketch_constraint": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "type": "string" },
        "a": {},
        "b": {}
      },
      "allOf": [
        {
          "if": {
            "properties": { "type": { "const": "equal" } }
          },
          "then": {
            "required": ["a", "b"],
            "properties": {
              "a": { "$ref": "#/$defs/equal_target" },
              "b": { "$ref": "#/$defs/equal_target" }
            }
          }
        }
      ]
    },
    "equal_target": {
      "description": "Explicit equal-target kind; a bare entity ID is accepted for legacy line-length targets.",
      "oneOf": [
        {
          "type": "string",
          "pattern": "^ent:[a-zA-Z0-9_-]+$"
        },
        {
          "type": "object",
          "required": ["line"],
          "properties": {
            "line": {
              "type": "string",
              "pattern": "^ent:[a-zA-Z0-9_-]+$"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["radius"],
          "properties": {
            "radius": {
              "type": "string",
              "pattern": "^ent:[a-zA-Z0-9_-]+$"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "parameter": {
      "type": "object",
      "required": ["id", "name", "expr"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^param:[a-zA-Z0-9_-]+$"
        },
        "name": { "type": "string" },
        "expr": { "type": "string" },
        "role": { "type": "string" },
        "ai_edit_policy": {
          "type": "object",
          "properties": {
            "min": { "type": "string" },
            "max": { "type": "string" },
            "preferred_step": { "type": "string" }
          }
        }
      }
    }
  }
}
