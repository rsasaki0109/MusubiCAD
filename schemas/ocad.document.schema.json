{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opencad.dev/schemas/ocad.document.v0.1.json",
  "title": "MusubiCAD Document",
  "type": "object",
  "required": ["schema", "document"],
  "properties": {
    "schema": {
      "type": "string",
      "const": "opencad.document.v0.1"
    },
    "document": {
      "type": "object",
      "required": ["id", "name", "units"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^doc:[a-zA-Z0-9_-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "units": {
          "type": "string",
          "enum": ["m", "mm", "cm", "in"]
        },
        "kind": {
          "type": "string",
          "enum": ["part", "assembly", "drawing"],
          "default": "part"
        },
        "created_with": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "parameters": {
      "type": "array",
      "items": { "$ref": "#/$defs/parameter" }
    },
    "sketches": {
      "type": "array",
      "items": { "$ref": "#/$defs/sketch" }
    },
    "features": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "definition": {
            "type": "object",
            "allOf": [
              { "if": { "properties": { "type": { "const": "datum_plane" } }, "required": ["type"] }, "then": { "$ref": "#/$defs/datum_plane" } },
              { "if": { "properties": { "type": { "const": "datum_axis" } }, "required": ["type"] }, "then": { "$ref": "#/$defs/datum_axis" } }
            ]
          }
        }
      }
    },
    "materials": {
      "type": "array",
      "items": { "type": "object" }
    },
    "ai": {
      "type": "object",
      "properties": {
        "intent_summary": { "type": "string" },
        "editable_parameters": {
          "type": "array",
          "items": { "type": "string" }
        },
        "semantic_tags": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    }
  },
  "$defs": {
      "datum_workplane": {
        "type": "object",
        "required": [
          "type",
          "feature_id"
        ],
        "properties": {
          "type": {
            "const": "datum_plane"
          },
          "feature_id": {
            "type": "string",
            "pattern": "^feature:"
          }
        },
        "additionalProperties": false
      },
      "datum_plane": {
        "type": "object",
        "required": [
          "type",
          "base",
          "offset"
        ],
        "properties": {
          "type": {
            "const": "datum_plane"
          },
          "base": {
            "type": "object"
          },
          "offset": {
            "type": "object",
            "required": [
              "value_si"
            ],
            "properties": {
              "value_si": {
                "type": "number"
              }
            }
          },
          "offset_expr": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": false
      },
      "datum_axis": {
        "type": "object",
        "required": [
          "type",
          "origin_m",
          "direction"
        ],
        "properties": {
          "type": {
            "const": "datum_axis"
          },
          "origin_m": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": {
              "type": "number"
            }
          },
          "direction": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": {
              "type": "number"
            }
          },
          "origin_expr": {
            "type": [
              "array",
              "null"
            ],
            "minItems": 3,
            "maxItems": 3,
            "items": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "additionalProperties": false
      },
    "sketch": {
      "type": "object",
      "properties": {
        "workplane": {
          "type": "object",
          "allOf": [{ "if": { "properties": { "type": { "const": "datum_plane" } }, "required": ["type"] }, "then": { "$ref": "#/$defs/datum_workplane" } }]
        },
        "constraints": {
          "type": "array",
          "items": { "$ref": "#/$defs/sketch_constraint" }
        }
      }
    },
    "sketch_constraint": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "type": "string" },
        "a": {},
        "b": {}
      },
      "allOf": [
        {
          "if": {
            "properties": { "type": { "const": "equal" } }
          },
          "then": {
            "required": ["a", "b"],
            "properties": {
              "a": { "$ref": "#/$defs/equal_target" },
              "b": { "$ref": "#/$defs/equal_target" }
            }
          }
        }
      ]
    },
    "equal_target": {
      "description": "Explicit equal-target kind; a bare entity ID is accepted for legacy line-length targets.",
      "oneOf": [
        {
          "type": "string",
          "pattern": "^ent:[a-zA-Z0-9_-]+$"
        },
        {
          "type": "object",
          "required": ["line"],
          "properties": {
            "line": {
              "type": "string",
              "pattern": "^ent:[a-zA-Z0-9_-]+$"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["radius"],
          "properties": {
            "radius": {
              "type": "string",
              "pattern": "^ent:[a-zA-Z0-9_-]+$"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "parameter": {
      "type": "object",
      "required": ["id", "name", "expr"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^param:[a-zA-Z0-9_-]+$"
        },
        "name": { "type": "string" },
        "expr": { "type": "string" },
        "role": { "type": "string" },
        "ai_edit_policy": {
          "type": "object",
          "properties": {
            "min": { "type": "string" },
            "max": { "type": "string" },
            "preferred_step": { "type": "string" }
          }
        }
      }
    }
  }
}
