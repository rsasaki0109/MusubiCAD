          "type": "object",
          "allOf": [
            {
              "if": {
                "properties": {
                  "type": {
                    "const": "datum_plane"
                  }
                },
                "required": [
                  "type"
                ]
              },
              "then": {
                "$ref": "#/$defs/datum_workplane"
              }
            }
          ]
        },
        "constraints": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sketch_constraint"
          }
        },
        "entities": {
          "type": "array",
          "items": {
            "type": "object",
            "allOf": [
              {
                "if": {
                  "properties": {
                    "type": {
                      "const": "ellipse"
                    }
                  },
                  "required": [
                    "type"
                  ]
                },
                "then": {
                  "$ref": "#/$defs/ellipse"
                }
              },
              {
                "if": {
                  "properties": {
                    "type": {
                      "const": "cubic_bezier"
                    }
                  },
                  "required": [
                    "type"
                  ]
                },
                "then": {
                  "$ref": "#/$defs/cubic_bezier"
                }
              }
            ]
          }
        }
      }
