{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opencad.dev/schemas/ocad.document.v0.1.json",
  "title": "MusubiCAD Document",
  "type": "object",
  "required": ["schema", "document"],
  "properties": {
    "schema": {
      "type": "string",
      "const": "opencad.document.v0.1"
    },
    "document": {
      "type": "object",
      "required": ["id", "name", "units"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^doc:[a-zA-Z0-9_-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "units": {
          "type": "string",
          "enum": ["m", "mm", "cm", "in"]
        },
        "kind": {
          "type": "string",
          "enum": ["part", "assembly", "drawing"],
          "default": "part"
        },
        "created_with": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "parameters": {
      "type": "array",
      "items": { "$ref": "#/$defs/parameter" }
    },
    "sketches": {
      "type": "array",
      "items": { "$ref": "#/$defs/sketch" }
    },
    "features": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "definition": {
            "type": "object",
            "allOf": [
              {
                "if": {
                  "properties": {
                    "type": {
                      "const": "imported_mesh"
                    }
                  },
                  "required": [
                    "type"
                  ]
                },
                "then": {
                  "$ref": "#/$defs/imported_mesh"
                }
              },
              {
                "if": {
                  "properties": {
                    "type": {
                      "const": "faceted_circular_fillet"
                    }
                  },
                  "required": [
                    "type"
                  ]
                },
                "then": {
                  "$ref": "#/$defs/faceted_circular_fillet"
                }
              },
              {
                "if": {
                  "properties": {
                    "type": {
                      "const": "nominal_metric_thread"
                    }
                  },
                  "required": [
                    "type"
                  ]
                },
                "then": {
                  "$ref": "#/$defs/nominal_metric_thread"
                }
              },
              {
                "if": {
                  "properties": {
                    "type": {
                      "const": "cylindrical_draft"
                    }
                  },
                  "required": [
                    "type"
                  ]
                },
                "then": {
                  "$ref": "#/$defs/cylindrical_draft"
                }
              },
              {
                "if": {
                  "properties": {
                    "type": {
                      "const": "draft"
                    }
                  },
                  "required": [
                    "type"
                  ]
                },
                "then": {
                  "$ref": "#/$defs/draft"
                }
              },
              {
                "if": {
                  "properties": {
                    "type": {
                      "const": "tapered_rib"
                    }
                  },
                  "required": [
                    "type"
                  ]
                },
                "then": {
                  "$ref": "#/$defs/tapered_rib"
                }
              },
              {
                "if": {
                  "properties": {
                    "type": {
                      "const": "rib"
                    }
                  },
                  "required": [
                    "type"
                  ]
                },
                "then": {
                  "$ref": "#/$defs/rib"
                }
              },
              {
                "if": {
                  "properties": {
                    "type": {
                      "const": "body_boolean"
                    }
                  },
                  "required": [
                    "type"
                  ]
                },
                "then": {
                  "$ref": "#/$defs/body_boolean"
                }
              },
              {
                "if": {
                  "properties": {
                    "type": {
                      "const": "fillet"
                    }
                  },
                  "required": [
                    "type"
                  ]
                },
                "then": {
                  "$ref": "#/$defs/fillet"
                }
              },
              {
                "if": {
                  "properties": {
                    "type": {
                      "const": "standard_hole"
                    }
                  },
                  "required": [
                    "type"
                  ]
                },
                "then": {
                  "$ref": "#/$defs/standard_hole"
                }
              },
              {
                "if": {
                  "properties": {
                    "type": {
                      "const": "seated_standard_hole"
                    }
                  },
                  "required": [
                    "type"
                  ]
                },
                "then": {
                  "$ref": "#/$defs/seated_standard_hole"
                }
              },
              {
                "if": {
                  "properties": {
                    "type": {
                      "const": "datum_plane"
                    }
                  },
                  "required": [
                    "type"
                  ]
                },
                "then": {
                  "$ref": "#/$defs/datum_plane"
                }
              },
              {
                "if": {
                  "properties": {
                    "type": {
                      "const": "datum_axis"
                    }
                  },
                  "required": [
                    "type"
                  ]
                },
                "then": {
                  "$ref": "#/$defs/datum_axis"
                }
              },
              {
                "if": {
                  "properties": {
                    "type": {
                      "const": "projected_sketch"
                    }
                  },
                  "required": [
                    "type"
                  ]
                },
                "then": {
                  "$ref": "#/$defs/projected_sketch"
                }
              }
            ]
          }
        }
      }
    },
    "materials": {
      "type": "array",
      "items": { "type": "object" }
    },
    "ai": {
      "type": "object",
      "properties": {
        "intent_summary": { "type": "string" },
        "editable_parameters": {
          "type": "array",
          "items": { "type": "string" }
        },
        "semantic_tags": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    }
  },
  "$defs": {
    "seated_standard_hole": {
      "type": "object",
      "required": [
        "type",
        "sketch_feature",
        "profile_ref",
        "target_feature",
        "face_ref",
        "bore_depth",
        "standard",
        "seat"
      ],
      "properties": {
        "type": {
          "const": "seated_standard_hole"
        },
        "sketch_feature": {
          "type": "string",
          "pattern": "^feature:"
        },
        "profile_ref": {
          "type": "string"
        },
        "target_feature": {
          "type": "string",
          "pattern": "^feature:"
        },
        "face_ref": {
          "type": "string",
          "pattern": "^ref:face:",
          "minLength": 10
        },
        "standard": {
          "oneOf": [
            {
              "type": "object",
              "required": [
                "type",
                "size",
                "fit"
              ],
              "properties": {
                "type": {
                  "const": "iso273"
                },
                "size": {
                  "enum": [
                    "M3",
                    "M4",
                    "M5",
                    "M6",
                    "M8",
                    "M10",
                    "M12"
                  ]
                },
                "fit": {
                  "enum": [
                    "close",
                    "normal",
                    "loose"
                  ]
                }
              },
              "additionalProperties": false
            },
            {
              "type": "object",
              "required": [
                "type",
                "size",
                "representation"
              ],
              "properties": {
                "type": {
                  "const": "iso_metric_coarse"
                },
                "size": {
                  "enum": [
                    "M3",
                    "M4",
                    "M5",
                    "M6",
                    "M8",
                    "M10",
                    "M12"
                  ]
                },
                "representation": {
                  "const": "tap_drill"
                }
              },
              "additionalProperties": false
            }
          ]
        },
        "bore_depth": {
          "type": "object",
          "required": [
            "value_si"
          ],
          "properties": {
            "value_si": {
              "type": "number",
              "exclusiveMinimum": 1e-09,
              "maximum": 1000
            }
          },
          "additionalProperties": false
        },
        "bore_depth_expr": {
          "type": [
            "string",
            "null"
          ]
        },
        "seat": {
          "oneOf": [
            {
              "type": "object",
              "required": [
                "type",
                "diameter",
                "depth"
              ],
              "properties": {
                "type": {
                  "const": "counterbore"
                },
                "diameter": {
                  "type": "object",
                  "required": [
                    "value_si"
                  ],
                  "properties": {
                    "value_si": {
                      "type": "number",
                      "exclusiveMinimum": 1e-09,
                      "maximum": 1000
                    }
                  },
                  "additionalProperties": false
                },
                "depth": {
                  "type": "object",
                  "required": [
                    "value_si"
                  ],
                  "properties": {
                    "value_si": {
                      "type": "number",
                      "exclusiveMinimum": 1e-09,
                      "maximum": 1000
                    }
                  },
                  "additionalProperties": false
                },
                "diameter_expr": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "depth_expr": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "additionalProperties": false
            },
            {
              "type": "object",
              "required": [
                "type",
                "diameter",
                "included_angle"
              ],
              "properties": {
                "type": {
                  "const": "countersink"
                },
                "diameter": {
                  "type": "object",
                  "required": [
                    "value_si"
                  ],
                  "properties": {
                    "value_si": {
                      "type": "number",
                      "exclusiveMinimum": 1e-09,
                      "maximum": 1000
                    }
                  },
                  "additionalProperties": false
                },
                "diameter_expr": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "included_angle": {
                  "type": "object",
                  "required": [
                    "value_si"
                  ],
                  "properties": {
                    "value_si": {
                      "type": "number",
                      "exclusiveMinimum": 0,
                      "exclusiveMaximum": 3.141592653589793
                    }
                  },
                  "additionalProperties": false
                },
                "included_angle_expr": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "additionalProperties": false
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "projected_sketch": {
      "type": "object",
      "required": [
        "type",
        "sketch_id",
        "workplane",
        "projections"
      ],
      "properties": {
        "type": {
          "const": "projected_sketch"
        },
        "sketch_id": {
          "type": "string",
          "pattern": "^sketch:"
        },
        "workplane": {
          "oneOf": [
            {
              "type": "object",
              "required": [
                "type",
                "plane"
              ],
              "properties": {
                "type": {
                  "const": "global"
                },
                "plane": {
                  "enum": [
                    "XY",
                    "YZ",
                    "XZ"
                  ]
                }
              },
              "additionalProperties": false
            },
            {
              "type": "object",
              "required": [
                "type",
                "origin",
                "normal",
                "x_axis"
              ],
              "properties": {
                "type": {
                  "const": "custom"
                },
                "origin": {
                  "type": "array",
                  "items": {
                    "type": "number"
                  },
                  "minItems": 3,
                  "maxItems": 3
                },
                "normal": {
                  "type": "array",
                  "items": {
                    "type": "number"
                  },
                  "minItems": 3,
                  "maxItems": 3
                },
                "x_axis": {
                  "type": "array",
                  "items": {
                    "type": "number"
                  },
                  "minItems": 3,
                  "maxItems": 3
                }
              },
              "additionalProperties": false
            }
          ]
        },
        "projections": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "source_feature",
              "source_entity",
              "curve_id",
              "point_ids"
            ],
            "properties": {
              "source_feature": {
                "type": "string",
                "pattern": "^feature:"
              },
              "source_entity": {
                "type": "string",
                "pattern": "^ent:"
              },
              "curve_id": {
                "type": "string",
                "pattern": "^ent:"
              },
              "point_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^ent:"
                },
                "minItems": 1,
                "maxItems": 2
              },
              "construction": {
                "type": "boolean"
              }
            },
            "additionalProperties": false
          },
          "minItems": 1,
          "maxItems": 256
        }
      },
      "additionalProperties": false
    },
    "cubic_bezier": {
      "type": "object",
      "required": [
        "type",
        "id",
        "control_points"
      ],
      "properties": {
        "type": {
          "const": "cubic_bezier"
        },
        "id": {
          "type": "string",
          "pattern": "^ent:"
        },
        "construction": {
          "type": "boolean"
        },
        "control_points": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "string",
            "pattern": "^ent:"
          }
        }
      },
      "additionalProperties": false
    },
    "ellipse": {
      "type": "object",
      "required": [
        "type",
        "id",
        "center",
        "major_radius",
        "minor_radius",
        "axis_angle"
      ],
      "properties": {
        "type": {
          "const": "ellipse"
        },
        "id": {
          "type": "string",
          "pattern": "^ent:"
        },
        "construction": {
          "type": "boolean"
        },
        "center": {
          "type": "string",
          "pattern": "^ent:"
        },
        "major_radius": {
          "anyOf": [
            {
              "type": "number",
              "exclusiveMinimum": 1e-09
            },
            {
              "type": "string",
              "minLength": 1
            }
          ]
        },
        "minor_radius": {
          "anyOf": [
            {
              "type": "number",
              "exclusiveMinimum": 1e-09
            },
            {
              "type": "string",
              "minLength": 1
            }
          ]
        },
        "axis_angle": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "string",
              "minLength": 1
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "imported_mesh": {
      "type": "object",
      "required": [
        "type",
        "source",
        "sha256",
        "source_unit",
        "transform"
      ],
      "properties": {
        "type": {
          "const": "imported_mesh"
        },
        "source": {
          "type": "string",
          "pattern": "^imports/[a-z0-9_]+([.-][a-z0-9_]+)*[.]stl$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "source_unit": {
          "enum": [
            "m",
            "mm",
            "cm",
            "in"
          ]
        },
        "transform": {
          "type": "object",
          "required": [
            "translation_m",
            "rotation"
          ],
          "properties": {
            "translation_m": {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "items": {
                "type": "number"
              }
            },
            "rotation": {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "items": {
                "type": "array",
                "minItems": 3,
                "maxItems": 3,
                "items": {
                  "type": "number"
                }
              }
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "faceted_circular_fillet": {
      "type": "object",
      "required": [
        "type",
        "target_feature",
        "edge_ref",
        "representation",
        "verification",
        "minimum_radius",
        "maximum_radius",
        "quality"
      ],
      "properties": {
        "type": {
          "const": "faceted_circular_fillet"
        },
        "target_feature": {
          "type": "string",
          "pattern": "^feature:.+"
        },
        "edge_ref": {
          "type": "string",
          "pattern": "^ref:edge:.+"
        },
        "representation": {
          "const": "grid_faceted_periodic_cosine"
        },
        "verification": {
          "const": "canonical_grid_with_numerical_backend_checks"
        },
        "minimum_radius": {
          "type": "object",
          "required": [
            "value_si"
          ],
          "properties": {
            "value_si": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          },
          "additionalProperties": false
        },
        "maximum_radius": {
          "type": "object",
          "required": [
            "value_si"
          ],
          "properties": {
            "value_si": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          },
          "additionalProperties": false
        },
        "quality": {
          "type": "object",
          "required": [
            "maximum_normal_chord",
            "ideal_volume_width_m3",
            "maximum_volume_difference_m3",
            "ideal_area_width_m2",
            "maximum_area_difference_m2",
            "ideal_first_moment_width_m4",
            "maximum_first_moment_difference_m4",
            "maximum_position_error",
            "ideal_centroid_width",
            "maximum_centroid_difference",
            "max_integration_cells",
            "max_vertices",
            "max_triangles"
          ],
          "properties": {
            "maximum_normal_chord": {
              "type": "number",
              "exclusiveMinimum": 0,
              "exclusiveMaximum": 1
            },
            "ideal_volume_width_m3": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "maximum_volume_difference_m3": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "ideal_area_width_m2": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "maximum_area_difference_m2": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "ideal_first_moment_width_m4": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "maximum_first_moment_difference_m4": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "maximum_position_error": {
              "type": "object",
              "required": [
                "value_si"
              ],
              "properties": {
                "value_si": {
                  "type": "number",
                  "exclusiveMinimum": 0
                }
              },
              "additionalProperties": false
            },
            "ideal_centroid_width": {
              "type": "object",
              "required": [
                "value_si"
              ],
              "properties": {
                "value_si": {
                  "type": "number",
                  "exclusiveMinimum": 0
                }
              },
              "additionalProperties": false
            },
            "maximum_centroid_difference": {
              "type": "object",
              "required": [
                "value_si"
              ],
              "properties": {
                "value_si": {
                  "type": "number",
                  "exclusiveMinimum": 0
                }
              },
              "additionalProperties": false
            },
            "max_integration_cells": {
              "type": "integer",
              "minimum": 1,
              "maximum": 262144
            },
            "max_vertices": {
              "type": "integer",
              "minimum": 4,
              "maximum": 10000
            },
            "max_triangles": {
              "type": "integer",
              "minimum": 4,
              "maximum": 10000
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "nominal_metric_thread": {
      "type": "object",
      "required": [
        "type",
        "target_feature",
        "face_ref",
        "representation",
        "size",
        "handedness",
        "turns",
        "ends"
      ],
      "properties": {
        "type": {
          "const": "nominal_metric_thread"
        },
        "target_feature": {
          "type": "string",
          "pattern": "^feature:"
        },
        "face_ref": {
          "type": "string",
          "pattern": "^ref:face:.+"
        },
        "representation": {
          "const": "nominal_metric_basic_flat_root"
        },
        "size": {
          "enum": [
            "m3",
            "m4",
            "m5",
            "m6",
            "m8",
            "m10",
            "m12"
          ]
        },
        "handedness": {
          "enum": [
            "right",
            "left"
          ]
        },
        "turns": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32
        },
        "ends": {
          "const": "square"
        }
      },
      "additionalProperties": false
    },
    "cylindrical_draft": {
      "type": "object",
      "required": [
        "type",
        "target_feature",
        "face_ref",
        "angle",
        "neutral_plane"
      ],
      "properties": {
        "type": {
          "const": "cylindrical_draft"
        },
        "target_feature": {
          "type": "string",
          "pattern": "^feature:"
        },
        "angle": {
          "type": "object",
          "required": [
            "value_si"
          ],
          "properties": {
            "value_si": {
              "type": "number",
              "minimum": -0.7853981633974483,
              "maximum": 0.7853981633974483,
              "not": {
                "exclusiveMinimum": -1e-08,
                "exclusiveMaximum": 1e-08
              }
            }
          },
          "additionalProperties": false
        },
        "angle_expr": {
          "type": [
            "string",
            "null"
          ]
        },
        "neutral_plane": {
          "oneOf": [
            {
              "type": "object",
              "required": [
                "type",
                "plane"
              ],
              "properties": {
                "type": {
                  "const": "global"
                },
                "plane": {
                  "enum": [
                    "XY",
                    "XZ",
                    "YZ"
                  ]
                }
              },
              "additionalProperties": false
            },
            {
              "type": "object",
              "required": [
                "type",
                "feature_id"
              ],
              "properties": {
                "type": {
                  "const": "datum_plane"
                },
                "feature_id": {
                  "type": "string",
                  "pattern": "^feature:"
                }
              },
              "additionalProperties": false
            },
            {
              "type": "object",
              "required": [
                "type",
                "face_ref"
              ],
              "properties": {
                "type": {
                  "const": "face_ref"
                },
                "face_ref": {
                  "type": "string",
                  "pattern": "^ref:face:"
                }
              },
              "additionalProperties": false
            },
            {
              "type": "object",
              "required": [
                "type",
                "origin",
                "normal",
                "x_axis"
              ],
              "properties": {
                "type": {
                  "const": "custom"
                },
                "origin": {
                  "type": "array",
                  "minItems": 3,
                  "maxItems": 3,
                  "items": {
                    "type": "number"
                  }
                },
                "normal": {
                  "type": "array",
                  "minItems": 3,
                  "maxItems": 3,
                  "items": {
                    "type": "number"
                  }
                },
